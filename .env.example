# Copie para .env (gitignored) e preencha. O Spring lê via spring.config.import.
# DB_URL e DB_USERNAME têm padrão em application.properties; só sobrescreva se precisar.
DB_PASSWORD=
# HS256 exige no mínimo 32 bytes. Gere com:
#   PowerShell: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
